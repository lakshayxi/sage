# Required for answer generation. Keep the real value in .env or the host's
# secret manager; never commit it.
GEMINI_API_KEY=

# Optional production overrides. The defaults are safe for local use and a
# same-origin curated demo.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
ALLOW_UPLOADS=false
CHAT_RATE_LIMIT=10/minute
CONVERSATION_RATE_LIMIT=10/minute
MAX_CONCURRENT_GENERATIONS=2
QUERY_LOGGING_ENABLED=true
CORS_ORIGINS=
